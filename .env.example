# Native PostgreSQL connection. Use a dedicated database role with only app-schema privileges.
DATABASE_URL=postgresql://clm_app:<REPLACE_ME>@127.0.0.1:5432/clm_uat
# Optional elevated migration connection. Keep in protected .env.migration, never the app service.
MIGRATION_DATABASE_URL=postgresql://clm_migrator:<REPLACE_ME>@127.0.0.1:5432/clm_uat
# One-time source values for npm run db:import-hosted; keep only in protected .env.migration.
SOURCE_DATABASE_URL=postgresql://<REPLACE_ME>
SOURCE_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SOURCE_SUPABASE_SERVICE_KEY=<REPLACE_ME>

# Absolute private storage path outside the app directory and web root.
EVIDENCE_STORAGE_DIR=C:/ProgramData/CLM-UAT/evidence

# High-entropy random string used as an HMAC pepper for tester access-code lookups.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_CODE_PEPPER=<REPLACE_ME>

# Set only while running npm run db:create-admin; do not persist this value after bootstrap.
ADMIN_BOOTSTRAP_PASSWORD=<REPLACE_ME>
