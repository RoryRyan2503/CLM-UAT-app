# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<REPLACE_ME>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<REPLACE_ME>
# SECURITY_NOTE: service role key bypasses Row Level Security. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_ME>

# High-entropy random string used as an HMAC pepper for tester access-code lookups.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_CODE_PEPPER=<REPLACE_ME>
